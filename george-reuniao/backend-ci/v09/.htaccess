# ERP IMPAR - George V0.9.1 - hotfix CORS / cookie de sessao
# Escopo: somente /api/george-reuniao/v09/.
# Nao instalar no .htaccess da raiz, /api ou /george-reuniao.

Options -Indexes

# Mantem a protecao de configuracoes da V0.9 RC1.
<FilesMatch "^(settings\..*\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-George-CORS-Policy "v09-0.9.1"
    # Limpa as DUAS tabelas de cabecalhos do Apache.
    # Evita wildcard herdado e duplicacao com cabecalhos de PHP/FastCGI.
    Header onsuccess unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header onsuccess unset Access-Control-Allow-Credentials
    Header always unset Access-Control-Allow-Credentials
    Header onsuccess unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Methods
    Header onsuccess unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Headers
    Header onsuccess unset Access-Control-Expose-Headers
    Header always unset Access-Control-Expose-Headers
    Header onsuccess unset Access-Control-Max-Age
    Header always unset Access-Control-Max-Age

    # Lista fechada: somente as duas origens oficiais.
    # Nunca combinar Access-Control-Allow-Origin: * com credentials: include.
    Header always set Access-Control-Allow-Origin "https://www.erpimpar.com.br" "expr=req('Origin') == 'https://www.erpimpar.com.br'"
    Header always set Access-Control-Allow-Origin "https://erpimpar.com.br" "expr=req('Origin') == 'https://erpimpar.com.br'"
    Header always set Access-Control-Allow-Credentials "true" "expr=req('Origin') == 'https://www.erpimpar.com.br' || req('Origin') == 'https://erpimpar.com.br'"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS" "expr=req('Origin') == 'https://www.erpimpar.com.br' || req('Origin') == 'https://erpimpar.com.br'"
    Header always set Access-Control-Allow-Headers "Content-Type, X-George-CSRF" "expr=req('Origin') == 'https://www.erpimpar.com.br' || req('Origin') == 'https://erpimpar.com.br'"
    Header always set Access-Control-Expose-Headers "Content-Disposition, X-George-CORS-Policy" "expr=req('Origin') == 'https://www.erpimpar.com.br' || req('Origin') == 'https://erpimpar.com.br'"
    # Sem cache de preflight durante esta homologacao.
    Header always set Access-Control-Max-Age "0" "expr=req('Origin') == 'https://www.erpimpar.com.br' || req('Origin') == 'https://erpimpar.com.br'"
    Header always merge Vary "Origin"
</IfModule>
